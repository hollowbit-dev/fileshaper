{
  "name": "filesmith",
  "version": "1.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.mjs",
    "dist:mac": "npm run fetch-ffmpeg && electron-builder --mac --publish never",
    "dist:win": "npm run fetch-ffmpeg && electron-builder --win --publish never",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs darwin arm64 && node scripts/fetch-ffmpeg.mjs darwin x64 && node scripts/fetch-ffmpeg.mjs win32 x64",
    "site": "node site/build.mjs",
    "dist": "npm run fetch-ffmpeg && electron-builder --mac --win --publish never"
  },
  "keywords": [],
  "author": "Elvis Zygmanta",
  "license": "GPL-3.0-or-later",
  "description": "Filesmith by Hollowbit: free, offline file toolbox. Compress videos, convert iPhone photos, merge and sign PDFs. Nothing is uploaded.",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "geist": "^1.9.2",
    "playwright": "1.48"
  },
  "productName": "Filesmith",
  "build": {
    "appId": "dev.hollowbit.filesmith",
    "productName": "Filesmith",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/build/*.map",
      "!node_modules/pdfjs-dist/build/pdf.{mjs,sandbox.mjs,sandbox.min.mjs,worker.mjs}",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdf-lib/{es,cjs,src,ts3.4}/**",
      "!node_modules/pdf-lib/dist/pdf-lib.{js,esm.js,esm.min.js}",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/{README,CHANGELOG}*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "Filesmith-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm",
            "avi",
            "wmv",
            "flv",
            "3gp",
            "mts",
            "m2ts",
            "mpg",
            "mpeg"
          ],
          "name": "Video file",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "jpg",
            "jpeg",
            "png",
            "webp",
            "heic",
            "heif",
            "gif",
            "bmp",
            "tif",
            "tiff",
            "avif"
          ],
          "name": "Image file",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "pdf"
          ],
          "name": "PDF file",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "mp3",
            "wav",
            "m4a",
            "aac",
            "ogg",
            "opus",
            "flac",
            "wma",
            "aiff",
            "aif"
          ],
          "name": "Audio file",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Filesmith-Setup-${version}-win-x64.exe",
      "include": "installer/installer.nsh",
      "differentialPackage": true
    },
    "afterPack": "scripts/after-pack.js",
    "copyright": "© 2026 Hollowbit · Elvis Zygmanta",
    "publish": [
      {
        "provider": "github",
        "owner": "hollowbit-dev",
        "repo": "filesmith"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}